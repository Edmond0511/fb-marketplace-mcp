{
  "name": "fb-marketplace-mcp",
  "version": "0.1.0",
  "description": "MCP server for searching, vetting and preparing Facebook Marketplace listings from Claude",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fb-marketplace-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
